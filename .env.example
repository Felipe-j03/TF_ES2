# Moodle (somente ambiente local de desenvolvimento)
MOODLE_DB_PASSWORD=moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin123!
MOODLE_ADMIN_EMAIL=admin@example.com

# Token do serviço REST: o docker compose o cria no Moodle e o entrega ao acompanhamento.
# Valor fixo e apenas local; troque se quiser outro.
MOODLE_TOKEN=reengajamento-local-token-es2-01
# Id da disciplina ES2DEMO (a primeira disciplina criada num Moodle novo tem id 2)
MOODLE_CURSO_ID=2

# RabbitMQ
RABBITMQ_USER=reengajamento
RABBITMQ_PASS=reengajamento
# Portas no host; altere se já estiverem em uso na sua máquina
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Intervalo entre verificações (ISO-8601). Use PT1M para demonstração.
ACOMPANHAMENTO_INTERVALO=PT1H

# Notificações: envio pelo Mailpit local (sem autenticação) e tentativas persistidas
NOTIFICACOES_REMETENTE=noreply@reengajamento.local
NOTIFICACOES_MAX_TENTATIVAS=5
NOTIFICACOES_INTERVALO_RETENTATIVA=PT30S
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
